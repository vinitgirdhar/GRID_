{
  "appId": "local.grid.driver",
  "appName": "GRID Driver",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    },
    "BackgroundRunner": {
      "label": "GRID Driver Tracking",
      "src": "dist/background/presence-runner.js",
      "event": "driverPresenceTick",
      "repeat": true,
      "interval": 60,
      "autoStart": false
    }
  },
  "android": {
    "allowMixedContent": true
  }
}
